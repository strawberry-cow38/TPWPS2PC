<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TPW.PS2.Data</AssemblyName>
    <!-- Readers only. Nothing here opens a window or knows about Godot, so the format work stays
         testable without either. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="tpwps2sshscore" />
    <!-- ⭐ NLayer decodes MPEG Layer I/II/III in pure managed C#, which is the whole point: the
         engine's own decoder is built for Layer III and hands back nothing for the Layer II the
         disc actually uses, and a native plugin would have to be built per platform. 1,849 of the
         disc's 2,220 sounds are Layer II. -->
    <PackageReference Include="NLayer" Version="1.16.0" />
  </ItemGroup>
</Project>
